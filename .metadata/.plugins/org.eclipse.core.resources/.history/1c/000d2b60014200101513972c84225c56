package com.dsa.deque;


public class DeQue {
	
	private int queue[];
	private int capacity;
	private int size;
	private int front;
	private int rear;
	
	public DeQue(int capacity) {
		this.queue = new int[capacity];
		this.capacity = capacity;
		this.size = 0;
		this.front = -1;
		this.rear = -1;
	}
	
	public boolean isFull() {
		return capacity == size;
	}
	
	public boolean isEmpty() {
		return size == 0;
	}
		
	
	public void insertFront(int data) {
		if (isFull()) {
			System.out.println("Queue is fulll!!");			
			return;
		}
		
		if (isEmpty()) {
			front = rear = 0;
		}else if (front == 0) {
			front = capacity - 1;			
		}else {
			front--;
		}
		
		queue[front] = data;
		size++;
	}
	
	public void insertRear(int data) {
		if (isFull()) {
			System.out.println("Queue is full!!");			
			return;
		}
		
		if (isEmpty()) {
			front = rear = -1;			
		}else if(rear == capacity - 1) {
			rear = 0;			
		}else {
			rear++;
		}
		
		queue[rear] = data;
		size++;
	}
	
	public void deleteFront() {
		if (isEmpty()) {
			System.out.println("Queue is empty!!");			
			return;
		}
		
		int data = queue[front];
		
		if (front == rear) {
			rear = front = -1;
		}else if (front == capacity - 1) {
			front = 0;			
		}else {
			front++;
		}
		
		size--;
		System.out.println("Delete element front : " + data);
	}
	
	public void deleteRear() {
		if (isEmpty()) {
			System.out.println("Queue is empty!!");
			return;			
		}
		
		int data = queue[rear];
		
		if (rear == front) {
			rear = front = -1;
		}else if (rear == 0) {
			rear = capacity -1;			
		}else {
			rear--;
		}
		
		size--;
		System.out.println("Delete element rear : " + data);
	}
	
	public void getFront() {
		if (isEmpty()) {
			System.out.println("Queue is empty!!");
			return;			
		}
		
		System.out.println("Front element : " + queue[front]);
	}
	
	public void getRear() {
		if (isEmpty()) {
			System.out.println("Queue is empty!!");
			return;
		}
		
		System.out.println("Rear element : " + queue[rear]);
	}
	
	public void display() {
		if (isEmpty()) {
			System.out.println("Queue is empty!!");
			return;			
		}
		
		for(int i = 0; i < size; i++) {
			System.out.print(queue[(front + i) % capacity] + " ");
		}
		System.out.println();
	}
	
	public void size() {
		System.out.println("Queue size : " + size);
	}
	
	public static void main(String[] args) {
		DeQue dq = new DeQue(5);
		
		dq.insertFront(10);
		dq.insertFront(20);
		dq.insertRear(30);
		dq.insertRear(40);
		dq.insertFront(50);
		
		dq.display();
		
		dq.size();
		
		dq.deleteFront();
		dq.display();
		
		dq.insertRear(50);
		dq.display();
		
		
	}

}
