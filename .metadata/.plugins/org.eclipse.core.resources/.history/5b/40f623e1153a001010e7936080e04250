package com.dsa.linkedList;

public class CircularLinked {
	
	class Node{
		int data;
		Node prev;
		Node next;
		
		public Node(int data){
			this.data = data;
			this.prev = null;
			this.next = null;
		}
	}
	
	private Node head;
	private Node tail;
	
	public CircularLinked(){
		this.head = this.tail = null;
	}
	
	public void insertStart(int item) {
		Node newNode = new Node(item);
		if(head == null) {
			head = tail = newNode;
			return;
		}
		
		if (head != null) {
			head.prev = newNode;
			newNode.next = head;
			newNode.prev = head;
			head.next = newNode;
			head = newNode;
		}
	}
	
	
	

}
