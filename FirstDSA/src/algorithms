** BINARY SEARCH -- O(log n)  **

1) while(low <= high)
2) mid = (low + high) / 2
3) if x == arr[mid]
	return arr[mid]
4) if x > arr[mid]
	low = mid + 1
5) else
	high = mid - 1
exit.



** BUBBLE SORT -- O(n2)  **

1) for (i = 0; i < arr.length; i++)
2)		for(j = 0; j < arr.length - i - 2)
3)			if arr[i] > arr[j + 1]
				swap (arr[i] and arr[j + 1])
				


** SELECTION SORT -- O(n2) **

1) for (i = 0; i < n - 2; i++)
2)		min = i
3) 		for(j = i + 1; j < n - 1; j++)
4)			if arr[j] < arr[min]
				min = j
5)		if min != i
			swap (arr[i] and arr[min]) 
			


** INSERTION SORT -- O(n2) **

	n = arr.length;
1)	for(i = 1  to  i < n - 1)
		key = arr[i]
		j = i - 1
2)		while(j >= 0  and  arr[j]  >  key)
			arr[j + 1] = arr[j]
			j = j - 1
		arr[j + 1] = key
		
			
			