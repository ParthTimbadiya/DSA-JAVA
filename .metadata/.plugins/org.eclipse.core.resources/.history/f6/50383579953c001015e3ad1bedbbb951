package com.dsa.queue;

public class SimpleQueue {
	
	private int queue[];
	private int size;
	private int front;
	private int rear;
	
	public SimpleQueue(int size) {
		this.size = size;
		this.queue = new int[size];
		this.front = 0;
		this.rear = -1;
		
	}
	
//	insert rear : Enqueue
	
	public void enqueue(int data) {
		if (rear == size - 1) {
			System.out.println("Queue is full!");			
			return;
		}
		rear++;
		queue[rear] = data;
	}

}
