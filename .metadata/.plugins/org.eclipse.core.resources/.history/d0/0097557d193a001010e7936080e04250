package com.dsa.linkedList;

import javax.swing.text.html.HTMLDocument.HTMLReader.PreAction;

public class CircularLinked {
	
	class Node{
		int data;
		Node prev;
		Node next;
		
		public Node(int data){
			this.data = data;
			this.prev = null;
			this.next = null;
		}
	}
	
	private Node head;
	private Node tail;
	
	public CircularLinked(){
		this.head = this.tail = null;
	}
	
	public void insertStart(int item) {
		Node newNode = new Node(item);
		if(head == null) {
			head = tail = newNode;
			head.next = head.prev = head;
		}else {
			head.prev = newNode;
			newNode.next = head;
			newNode.prev = tail;
			tail.next = newNode;
			head = newNode;
		}
		
	}
	
	public void insertEnd(int item) {
		Node newNode = new Node(0);
		if (tail == null) {
			tail = head = newNode;
			head.next = head.prev = null;
		}else {
			tail.next = newNode;
			newNode.prev = tail;
			newNode.next = head;
			head.prev = newNode;
			tail = newNode;
		}
	}
	
	
	public void deleteFront() {
		if(head == null) {
			System.out.println("List is Empty!!");
			return;
		}
		
		if (head == tail) {
			head = tail = null;
			return;
		}
		
		head = head.next;
		head.prev = tail;
		tail.next = head;
	}
	
	public void deleteEnd() {
		if (tail == null) {
			System.out.println("List is Empty!!");			
			return;
		}
		
		if (tail == head) {
			tail = head = null;
			return;
		}
		
		tail = tail.prev;
		tail.next = head;
		head.prev = tail;
	}
	
	public void printForward() {
		if (head == null) {
			System.out.println("List is Empty!!");			
			return;
		}
		Node temp = head;
		do {
			System.out.print(temp.data + " ");
			temp = temp.next;
		}while(temp != head);
	}
	
	public void printBackward() {
		if (tail == null) {
			System.out.println("List is Empty!!");			
			return;
		}
		
		Node temp = tail;
		do {
			System.out.print(temp.data + " ");			
			temp = temp.prev;
		} while (tail != temp);
		System.out.println();
	}
	
	
	

}
