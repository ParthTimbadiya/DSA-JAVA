package com.dsa.stack;

public class ReverseStringInStack {
	
	public static String reverseString(String str) {
		
		StackwithArray stack = new StackwithArray(str.length());
		
		for(int i = 0; i < str.length(); i++) {
			char ch = str.charAt(i);
			stack.push(ch);
		}
		
		while(!stack.isEmpty()) {
			int as = stack.pop();
		}
		
		return "";
	}

}
