** BINARY SEARCH -- O(n)  **

1) while(low <= high)
2) mid = (low + high) / 2
3) if x == arr[mid]
	return arr[mid]
4) if x > arr[mid]
	low = mid + 1
5) else
	high = mid - 1
exit.



** BUBBLE SORT -- O(log n)  **

1) for (i = 0; i < arr.length; i++)
2)		for(j = 0; j < arr.length - i - 2)
3)			if arr[i] > arr[j + 1]
				swap (arr[i] and arr[j + 1])