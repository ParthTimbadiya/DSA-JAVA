package com.dsa.stack;

public class StackwithLinkedList {
	
	class Node{
		int data;
		Node next;
		
		Node(int data){
			this.data = data;
			this.next = null;
		}
	}
	
	Node top;
	public StackwithLinkedList() {
		this.top = null;
	}
	
	public void push(int data) {
		Node newNode = new Node(data);
		if (isEmpty()) {
			top = newNode;
			return;
		}
		
		newNode.next = top;
		top = newNode;
		
	}
	
	public boolean isEmpty() {
		if (top == null) {	
			return true;
		}else {
			return false;
		}
	}

}
